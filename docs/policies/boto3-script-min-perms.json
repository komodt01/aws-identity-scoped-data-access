{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityScopedDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/identity-scoped-access-user-items"
    }
  ]
}
